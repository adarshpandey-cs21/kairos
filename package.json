{
  "name": "@adarsh-pandey/kairos",
  "version": "0.1.0",
  "description": "Kairos — plug-and-play personal productivity MCP server, driven by Claude Code CLI",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "productivity",
    "todoist",
    "planner",
    "habits",
    "kairos"
  ],
  "homepage": "https://github.com/adarshpandey-cs21/kairos#readme",
  "bugs": {
    "url": "https://github.com/adarshpandey-cs21/kairos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarshpandey-cs21/kairos.git"
  },
  "license": "MIT",
  "author": {
    "name": "Adarsh Pandey"
  },
  "type": "module",
  "bin": {
    "kairos": "./dist/cli/index.js"
  },
  "files": ["dist", "skills", "README.md", "LICENSE", "DEVELOPMENT.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev:mcp": "tsx src/mcp/index.ts",
    "cli": "tsx src/cli/index.ts",
    "setup": "pnpm run build && node dist/cli/index.js setup",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@doist/todoist-api-typescript": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "uuid": "^10.0.0",
    "write-file-atomic": "^5.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "semantic-release": "^24.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
